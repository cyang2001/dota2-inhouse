{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dota-inhouse",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "dota-inhouse",
    "database_id": "00000000-0000-4000-8000-000000000001"
  }]
}
